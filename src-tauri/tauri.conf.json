{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalkSee",
  "version": "0.4.0",
  "identifier": "com.smallmj.talksee",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm package:runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "语见 · TalkSee",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/runtime": "runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyMTk2MzY2QTY3NTI0OUMKUldTY0pIV21abU1aMHFKV2RLOUVBdlZhSlFsSWp6UmhtL0JSNjhDSXJoT0x3cGQzODE3Tk1JNmcK",
      "endpoints": [
        "https://github.com/smallmj/talksee/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
