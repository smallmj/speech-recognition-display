{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：事件监听 + 应用自定义命令 + 托盘/热键/单实例（T13）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-always-on-top",
    "core:tray:default",
    "core:app:default",
    "global-shortcut:default"
  ]
}
