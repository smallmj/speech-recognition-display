# 工具缓存/临时目录
.dsh-vision-toolkit/
.scratch/
node_modules/
dist/
target/

# Tauri 构建产物（gen 内的 schema 由 tauri-build 生成，按需提交）
src-tauri/gen/
src-tauri/target/
*.log

# ASR sidecar 运行时（Python venv 与下载的模型不进 git）
src-tauri/.venv/
src-tauri/asr-models/

# 打包运行时由 scripts/package-runtime.mjs 构建期生成，不进 git
src-tauri/resources/runtime/venv/
src-tauri/resources/runtime/sherpa_streaming.py

# 更新签名私钥：生成于 ~/.tauri/talksee.key（仓库外），绝不可提交。
# 若私钥被误复制进仓库，*.key / *.pub 通配可阻止误提交。
*.key
*.pub
~/.tauri/

# 系统文件
.DS_Store

# Python 字节码缓存
__pycache__/
*.pyc
